// Prisma Schema for Tiketix - All-in-One Booking & Ticketing Event System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ORGANIZER
  ATTENDEE
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  EXPIRED
  FAILED
}

enum TicketStatus {
  ACTIVE
  CHECKED_IN
  CANCELLED
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  name          String    @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  role          UserRole  @default(ATTENDEE)
  phoneNumber   String?   @map("phone_number") @db.VarChar(30)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  events   Event[]   @relation("OrganizerEvents")
  bookings Booking[] @relation("UserBookings")

  @@map("users")
}

model Event {
  id           String      @id @default(uuid()) @db.Uuid
  organizerId  String      @map("organizer_id") @db.Uuid
  title        String      @db.VarChar(255)
  slug         String      @unique @db.VarChar(255)
  description  String?     @db.Text
  venueName    String      @map("venue_name") @db.VarChar(255)
  venueAddress String?     @map("venue_address") @db.Text
  posterUrl    String?     @map("poster_url") @db.VarChar(500)
  bannerUrl    String?     @map("banner_url") @db.VarChar(500)
  eventDate    DateTime    @map("event_date") @db.Timestamptz(6)
  endTime      DateTime?   @map("end_time") @db.Timestamptz(6)
  status       EventStatus @default(DRAFT)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  organizer   User         @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Restrict)
  ticketTiers TicketTier[]
  bookings    Booking[]

  // Indexes
  @@index([organizerId], name: "idx_events_organizer_id")
  @@index([slug], name: "idx_events_slug")
  @@map("events")
}

model TicketTier {
  id             String    @id @default(uuid()) @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  name           String    @db.VarChar(100)
  description    String?   @db.Text
  price          Decimal   @db.Decimal(12, 2)
  totalQuota     Int       @map("total_quota")
  availableQuota Int       @map("available_quota")
  startSaleDate  DateTime? @map("start_sale_date") @db.Timestamptz(6)
  endSaleDate    DateTime? @map("end_sale_date") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]
  tickets      Ticket[]

  // Indexes
  @@index([eventId], name: "idx_ticket_tiers_event_id")
  @@map("ticket_tiers")
}

model Booking {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  eventId     String        @map("event_id") @db.Uuid
  bookingCode String        @unique @map("booking_code") @db.VarChar(50)
  totalAmount Decimal       @map("total_amount") @db.Decimal(12, 2)
  status      BookingStatus @default(PENDING)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user                User                 @relation("UserBookings", fields: [userId], references: [id], onDelete: Restrict)
  event               Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)
  bookingItems        BookingItem[]
  paymentTransactions PaymentTransaction[]
  tickets             Ticket[]

  // Indexes
  @@index([userId], name: "idx_bookings_user_id")
  @@index([eventId], name: "idx_bookings_event_id")
  @@index([bookingCode], name: "idx_bookings_booking_code")
  @@map("bookings")
}

model BookingItem {
  id           String   @id @default(uuid()) @db.Uuid
  bookingId    String   @map("booking_id") @db.Uuid
  ticketTierId String   @map("ticket_tier_id") @db.Uuid
  quantity     Int
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal     Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketTier TicketTier @relation(fields: [ticketTierId], references: [id], onDelete: Restrict)
  tickets    Ticket[]

  // Indexes
  @@index([bookingId], name: "idx_booking_items_booking_id")
  @@index([ticketTierId], name: "idx_booking_items_ticket_tier_id")
  @@map("booking_items")
}

model PaymentTransaction {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @map("booking_id") @db.Uuid
  transactionCode String        @unique @map("transaction_code") @db.VarChar(100)
  paymentGateway  String        @default("MANUAL") @map("payment_gateway") @db.VarChar(50)
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(6)
  payload         Json?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  // Indexes
  @@index([bookingId], name: "idx_payment_transactions_booking_id")
  @@index([transactionCode], name: "idx_payment_transactions_transaction_code")
  @@map("payment_transactions")
}

model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  bookingId     String       @map("booking_id") @db.Uuid
  bookingItemId String       @map("booking_item_id") @db.Uuid
  ticketTierId  String       @map("ticket_tier_id") @db.Uuid
  ticketCode    String       @unique @map("ticket_code") @db.VarChar(50)
  qrHash        String       @unique @map("qr_hash") @db.VarChar(255)
  attendeeName  String       @map("attendee_name") @db.VarChar(255)
  attendeeEmail String       @map("attendee_email") @db.VarChar(255)
  status        TicketStatus @default(ACTIVE)
  checkedInAt   DateTime?    @map("checked_in_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Restrict)
  ticketTier  TicketTier  @relation(fields: [ticketTierId], references: [id], onDelete: Restrict)

  // Indexes
  @@index([bookingId], name: "idx_tickets_booking_id")
  @@index([bookingItemId], name: "idx_tickets_booking_item_id")
  @@index([ticketTierId], name: "idx_tickets_ticket_tier_id")
  @@index([qrHash], name: "idx_tickets_qr_hash")
  @@map("tickets")
}
