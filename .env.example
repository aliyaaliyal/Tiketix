# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=[SCHEMA]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tiketix_db?schema=public"

# Authentication / JWT (min 32 chars; REQUIRED in production — app refuses to boot without it)
# Generate: openssl rand -hex 32
JWT_SECRET="change-me-generate-with-openssl-rand-hex-32!!"
JWT_EXPIRES_IN="1d"

# CORS allowlist (comma-separated). Add your prod domain here.
FRONTEND_URL="http://localhost:5173"
