# URL backend saat development (tanpa trailing slash + /api/v1)
VITE_API_URL=http://localhost:5000/api/v1

# Mode demo presentasi:
#  - true  = kalau backend mati, tampilkan data contoh supaya demo tetap jalan
#  - false = kalau backend mati, tampilkan error jujur (untuk pemakaian nyata)
VITE_DEMO_MODE=false
